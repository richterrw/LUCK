# Alpaca API credentials. Get free paper-trading keys at https://alpaca.markets
# IMPORTANT: paper and live use DIFFERENT key pairs. Never commit your real .env.
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here

# Mode: "paper" (default, simulated) or "live" (real money).
# Live ALSO requires typing the confirmation phrase at startup.
LUCK_MODE=paper
